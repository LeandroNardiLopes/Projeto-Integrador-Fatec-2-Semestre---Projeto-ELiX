# Copie este arquivo com o nome .env e ajuste se precisar.
# No XAMPP, o usuário padrão do MySQL/MariaDB é root, sem senha.
DB_HOST=127.0.0.1
DB_PORTA=3306
DB_NOME=luvia
DB_USUARIO=root
DB_SENHA=

# true mostra os erros na tela (use só para testes)
APP_DEBUG=false
APP_FUSO=America/Sao_Paulo
# minutos sem uso até a sessão expirar
SESSAO_MINUTOS=60
